datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  RESIDENT
}

enum ConnectionStatus {
  ACTIVE
  INACTIVE
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
  CARRIED_FORWARD
}

enum PaymentMethod {
  ONLINE
  CASH
  UPI
  NEFT
  RTGS
  CHEQUE
  CREDIT_CARD
  ADJUSTMENT
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  password                String
  role                    Role
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  resident                Resident?
  auditLogs               AuditLog[]
  createdTickets          Ticket[]                 @relation("TicketCreatedBy")
  assignedTickets         Ticket[]                 @relation("TicketAssignee")
  ticketComments          TicketComment[]
  ticketUploads           TicketAttachment[]
  assignmentRules         AssignmentRule[]
  tenantApplicationAudits TenantApplicationAudit[]
}

model Resident {
  id                 String              @id @default(cuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id])
  residentNumber     String              @unique
  phone              String?
  tenantName         String?
  tenantPhone        String?
  createdAt          DateTime            @default(now())
  connections        Connection[]
  tickets            Ticket[]
  tenantApplications TenantApplication[]
}

model Connection {
  id                 String              @id @default(cuid())
  residentId         String
  resident           Resident            @relation(fields: [residentId], references: [id])
  tower              String
  floor              String
  flatNo             String              @unique
  unitType           String
  unitArea           Int
  meterNo            String?
  sanctionedLoad     Decimal
  status             ConnectionStatus    @default(ACTIVE)
  connectedAt        DateTime            @default(now())
  meterReadings      MeterReading[]
  bills              Bill[]
  maintenanceBills   MaintenanceBill[]
  tickets            Ticket[]
  tenantApplications TenantApplication[]
}

model Rate {
  id            String   @id @default(cuid())
  ncplPerUnit   Decimal
  dgFixed       Decimal
  fixedPerKw    Decimal
  effectiveFrom DateTime
}

model MeterReading {
  id           String     @id @default(cuid())
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id])
  readingDate  DateTime
  ncplPrevious Decimal
  ncplCurrent  Decimal
  ncplUnits    Decimal
  dgPrevious   Decimal    @default(0)
  dgCurrent    Decimal    @default(0)
  dgUnits      Decimal    @default(0)
  recordedById String
  createdAt    DateTime   @default(now())
  bill         Bill?
}

model Bill {
  id                 String       @id @default(cuid())
  connectionId       String
  connection         Connection   @relation(fields: [connectionId], references: [id])
  meterReadingId     String       @unique
  meterReading       MeterReading @relation(fields: [meterReadingId], references: [id])
  billNumber         String       @unique
  billDate           DateTime
  dueDate            DateTime
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  ncplUnits          Decimal
  ratePerUnit        Decimal
  ncplCharge         Decimal
  dgCharge           Decimal
  fixedCharge        Decimal
  previousDues       Decimal      @default(0)
  totalAmount        Decimal
  paidAmount         Decimal      @default(0)
  status             BillStatus   @default(PENDING)
  createdAt          DateTime     @default(now())
  payments           Payment[]

  // Set when this bill's unpaid balance was rolled into a later bill's previousDues.
  // Such a bill is no longer separately payable — the later bill carries the amount.
  carriedForwardToId String?
  carriedForwardTo   Bill?   @relation("BillCarryForward", fields: [carriedForwardToId], references: [id], onDelete: SetNull)
  carriedForwardFrom Bill[]  @relation("BillCarryForward")

  @@index([carriedForwardToId])
}

model Payment {
  id                String        @id @default(cuid())
  billId            String
  bill              Bill          @relation(fields: [billId], references: [id])
  amount            Decimal
  paymentDate       DateTime
  method            PaymentMethod
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  status            PaymentStatus
  receiptNumber     String        @unique
  createdAt         DateTime      @default(now())
}

enum MaintenanceBillStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
}

model MaintenanceRate {
  id            String   @id @default(cuid())
  ratePerSqFt   Decimal  @db.Decimal(10, 2)
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  bills MaintenanceBill[]
}

model MaintenanceBill {
  id                 String                @id @default(cuid())
  connectionId       String
  maintenanceRateId  String
  billNumber         String                @unique
  billDate           DateTime
  dueDate            DateTime
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  unitArea           Int
  ratePerSqFt        Decimal               @db.Decimal(10, 2)
  amount             Decimal               @db.Decimal(10, 2)
  previousDue        Decimal               @default(0) @db.Decimal(10, 2)
  paidAmount         Decimal               @default(0) @db.Decimal(10, 2)
  interestCharge     Decimal               @default(0) @db.Decimal(10, 2)
  status             MaintenanceBillStatus @default(PENDING)
  createdAt          DateTime              @default(now())

  connection Connection           @relation(fields: [connectionId], references: [id])
  rate       MaintenanceRate      @relation(fields: [maintenanceRateId], references: [id])
  payments   MaintenancePayment[]
}

model MaintenancePayment {
  id                String        @id @default(cuid())
  maintenanceBillId String
  amount            Decimal       @db.Decimal(10, 2)
  paymentDate       DateTime
  method            PaymentMethod
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  status            PaymentStatus
  receiptNumber     String        @unique
  createdAt         DateTime      @default(now())

  bill MaintenanceBill @relation(fields: [maintenanceBillId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())
}

model FlatInfo {
  id       String @id @default(cuid())
  flatNo   String @unique
  tower    String
  floor    String
  unitType String
  area     Int
}

model Permission {
  id        String   @id @default(cuid())
  role      Role
  page      String
  canRead   Boolean  @default(false)
  canWrite  Boolean  @default(false)
  canDelete Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([role, page])
}

model SiteConfig {
  id                        String  @id @default("singleton")
  maintenanceMode           Boolean @default(false)
  maintenanceBillingEnabled Boolean @default(false)
  helpDeskEnabled           Boolean @default(false)
  tenantVerificationEnabled Boolean @default(false)
  cgstRate                  Decimal @default(9) @db.Decimal(5, 2)
  sgstRate                  Decimal @default(9) @db.Decimal(5, 2)
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
  AUTO_CLOSED
  CANCELLED
  NOT_AN_ISSUE
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintType {
  PERSONAL
  PUBLIC
}

enum AssignmentSlotKind {
  TICKET
  VISIT
}

model TicketCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  subCategories   TicketSubcategory[]
  tickets         Ticket[]
  escalationRules EscalationRule[]
  assignmentRules AssignmentRule[]
}

model TicketSubcategory {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  category        TicketCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tickets         Ticket[]
  assignmentRules AssignmentRule[]

  @@unique([categoryId, name])
}

model Ticket {
  id              String         @id @default(cuid())
  ticketNumber    String         @unique
  residentId      String
  connectionId    String?
  categoryId      String
  subcategoryId   String?
  assigneeId      String?
  createdById     String
  description     String         @db.Text
  priority        TicketPriority @default(MEDIUM)
  status          TicketStatus   @default(OPEN)
  complaintType   ComplaintType  @default(PERSONAL)
  escalationLevel Int            @default(0)
  slaDueAt        DateTime?
  lastEscalatedAt DateTime?
  closedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  resident    Resident           @relation(fields: [residentId], references: [id])
  connection  Connection?        @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  category    TicketCategory     @relation(fields: [categoryId], references: [id])
  subcategory TicketSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  assignee    User?              @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User               @relation("TicketCreatedBy", fields: [createdById], references: [id])
  comments    TicketComment[]
  attachments TicketAttachment[]

  @@index([status])
  @@index([residentId])
  @@index([connectionId])
  @@index([assigneeId])
  @@index([categoryId])
  @@index([updatedAt])
}

model TicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  body       String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

model TicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  uploadedById String?
  fileName     String
  mimeType     String
  sizeBytes    Int
  data         Bytes    @db.MediumBlob
  createdAt    DateTime @default(now())

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ticketId])
}

model EscalationRule {
  id         String         @id @default(cuid())
  categoryId String
  priority   TicketPriority
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  category TicketCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  steps    EscalationStep[]

  @@unique([categoryId, priority])
}

model EscalationStep {
  id           String @id @default(cuid())
  ruleId       String
  level        Int
  timeValue    Int
  timeUnit     String @default("MINUTES") @db.VarChar(20)
  contactName  String
  contactEmail String
  contactPhone String

  rule EscalationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, level])
}

model AssignmentRule {
  id            String   @id @default(cuid())
  categoryId    String
  subcategoryId String?
  assigneeId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category    TicketCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory TicketSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  assignee    User               @relation(fields: [assigneeId], references: [id])
  slots       AssignmentSlot[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([assigneeId])
}

model AssignmentSlot {
  id        String             @id @default(cuid())
  ruleId    String
  kind      AssignmentSlotKind
  startTime String             @db.VarChar(5)
  endTime   String             @db.VarChar(5)
  day       String             @default("EVERYDAY") @db.VarChar(20)

  rule AssignmentRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

enum TenantApplicationStatus {
  PENDING
  DOCUMENTS_SUBMITTED
  OWNER_APPROVED
  OWNER_REJECTED
  POLICE_VERIFICATION_PENDING
  POLICE_VERIFIED
  POLICE_VERIFICATION_FAILED
  MANAGEMENT_APPROVED
  MANAGEMENT_REJECTED
  ACTIVE
  INACTIVE
}

enum VerificationDocumentType {
  ID_PROOF
  ADDRESS_PROOF
  RENT_AGREEMENT
  NOC
  PHOTO
  OTHER
}

model TenantApplication {
  id                    String                  @id @default(cuid())
  applicationNumber     String                  @unique
  residentId            String?
  connectionId          String?
  tenantName            String
  tenantPhone           String
  tenantEmail           String?
  tenantIdProof         String?
  moveInDate            DateTime?
  moveOutDate           DateTime?
  status                TenantApplicationStatus @default(PENDING)
  ownerApprovedAt       DateTime?
  ownerApprovedBy       String?
  managementApprovedAt  DateTime?
  managementApprovedBy  String?
  policeVerifiedAt      DateTime?
  policeVerificationRef String?
  applicationToken      String                  @unique
  otpExpiresAt          DateTime?
  otpVerified           Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  resident   Resident?                @relation(fields: [residentId], references: [id], onDelete: SetNull)
  connection Connection?              @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  documents  TenantDocument[]
  family     TenantFamilyMember[]
  auditLogs  TenantApplicationAudit[]

  @@index([status])
  @@index([applicationNumber])
  @@index([connectionId])
  @@index([applicationToken])
}

model TenantDocument {
  id            String                   @id @default(cuid())
  applicationId String
  application   TenantApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType  VerificationDocumentType
  fileName      String
  mimeType      String
  sizeBytes     Int
  data          Bytes                    @db.MediumBlob
  verified      Boolean                  @default(false)
  verifiedBy    String?
  verifiedAt    DateTime?
  createdAt     DateTime                 @default(now())
  uploadedBy    String?

  @@index([applicationId])
}

model TenantFamilyMember {
  id            String            @id @default(cuid())
  applicationId String
  application   TenantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fullName      String
  relation      String
  age           Int?
  idProof       String?
  createdAt     DateTime          @default(now())

  @@index([applicationId])
}

model TenantApplicationAudit {
  id            String                   @id @default(cuid())
  applicationId String
  application   TenantApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?                    @relation(fields: [userId], references: [id])
  action        String
  fromStatus    TenantApplicationStatus?
  toStatus      TenantApplicationStatus?
  meta          Json?
  createdAt     DateTime                 @default(now())

  @@index([applicationId])
  @@index([createdAt])
}
